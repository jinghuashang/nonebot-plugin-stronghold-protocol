{%- extends "base.html.jinja" -%}

{%- block body -%}
{% if maintenance -%}
<div class="note note--error">
  <p><span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l9 16.5H3z"/><path d="M12 9.5v4.5"/><path d="M12 17.2v.02"/></svg></span>服务器维护中：{{ maintenance }}</p>
</div>
{%- endif %}

<section class="section">
  <div class="section-head"><span class="kicker">ROSTER</span><h2>在线名单</h2></div>
  <div class="section-body">
    {% set ns = namespace(n=0) -%}
    {% for g in groups -%}
    <div class="group group--{{ g.key }}">
      <div class="group-head">
        <span class="dot"></span>
        <span class="label">{{ g.label }}</span>
        <span class="count">{{ g.count }}</span>
      </div>
      <div class="roster">
        {% for r in g.rows -%}{% set ns.n = ns.n + 1 %}
        <div class="row">
          <span class="num">{{ "%02d" | format(ns.n) }}</span>
          <div class="who">
            <b>{{ r.name }}</b>
            {%- if r.is_host %}<span class="tag">房主</span>{% endif %}
          </div>
          <div class="room">{% if r.room %}同盟 {{ r.room }}{% endif %}</div>
          <div class="diff">{% if r.difficulty %}{{ r.difficulty }}{% endif %}</div>
          <div class="since">{% if r.since %}{{ r.since }} 起{% endif %}</div>
        </div>
        {% endfor -%}
      </div>
    </div>
    {% endfor -%}
    {% if not groups %}<div class="empty">现在没有博士在线。</div>{% endif %}
  </div>
</section>

{% if more -%}
<div class="more">…… 还有 {{ more }} 人</div>
{%- endif %}
{%- endblock -%}
