{%- extends "base.html.jinja" -%}

{%- block body -%}
{% if chips -%}
<div class="chips">
  {% for label, value, cls in chips -%}
  <span class="chip"><i>{{ label }}</i><b class="{{ cls }}">{{ value }}</b></span>
  {% endfor -%}
</div>
{%- endif %}

{% if maintenance -%}
<div class="more">⚠️ 服务器维护中：{{ maintenance }}</div>
{%- endif %}

{% for g in groups -%}
<div class="group group--{{ g.key }}">
  <div class="group-head">
    <span class="dot"></span>
    <span class="label">{{ g.label }}</span>
    <span class="count">{{ g.count }}</span>
  </div>
  <div class="roster">
    {% for r in g.rows -%}
    <div class="row">
      <div class="who">
        <b>{{ r.name }}</b>
        {%- if r.is_host %}<span class="tag">房主</span>{% endif %}
      </div>
      <div class="meta">
        {%- if r.room %}<span class="room">同盟 {{ r.room }}</span>{%- endif -%}
        {%- if r.difficulty %}<span class="diff">{{ r.difficulty }}</span>{%- endif -%}
        <span class="since">{{ r.since }} 起</span>
      </div>
    </div>
    {% endfor -%}
  </div>
</div>
{% endfor -%}

{% if more -%}
<div class="more">…… 还有 {{ more }} 人</div>
{%- elif not groups -%}
<div class="more">现在没有博士在线。</div>
{%- endif %}
{%- endblock -%}
