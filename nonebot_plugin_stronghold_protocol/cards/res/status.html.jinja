{%- extends "base.html.jinja" -%}

{%- block body -%}
{% if chips -%}
<div class="chips">
  {% for label, value, cls in chips -%}
  <span class="chip"><i>{{ label }}</i><b class="{{ cls }}">{{ value }}</b></span>
  {% endfor -%}
</div>
{%- endif %}

{% if maintenance -%}
<div class="more">⚠️ 服务器维护中：{{ maintenance }}</div>
{%- endif %}

{% for g in groups -%}
<div class="group group--{{ g.key }}">
  <div class="group-head">
    <span class="dot"></span>
    <span class="label">{{ g.label }}</span>
    <span class="count">{{ g.count }}</span>
  </div>
  <div class="roster">
    {% for r in g.rows -%}
    <div class="who">
      <b>{{ r.name }}</b>
      {%- if r.is_host %} <span class="tag">房主</span>{% endif %}
      <span class="meta">
        {%- if r.room %}同盟 {{ r.room }}{% if r.difficulty %} · {{ r.difficulty }}{% endif %} · {% endif -%}
        {{ r.since }} 起
      </span>
    </div>
    {% endfor -%}
  </div>
</div>
{% endfor -%}

{% if more -%}
<div class="more">…… 还有 {{ more }} 人</div>
{%- elif not groups -%}
<div class="more">现在没有博士在线。</div>
{%- endif %}
{%- endblock -%}
