{%- extends "base.html.jinja" -%}

{%- block body -%}
<section class="section">
  <div class="section-head"><span class="kicker">MATCHES</span><h2>正在进行的对局</h2></div>
  <div class="section-body">
    {% for b in blocks -%}
    <div class="match">
      <div class="match-head">
        <span class="num">{{ "%02d" | format(loop.index) }}</span>
        <span class="room">{{ b.room }}</span>
        <span class="meta">{{ b.mode }} · {{ b.difficulty }}</span>
        <span class="time">{{ b.started }} 开始</span>
      </div>
      <div class="bar"><div class="fill" style="width: {{ b.progress }}%"></div></div>
      <div class="bar-label">
        <span>回合 {{ b.round }} / {{ b.boss }}</span>
        <span>{{ b.progress }}%</span>
      </div>
      <div class="squad">
        {% for p in b.humans -%}
        <span class="who{% if not p.alive %} dead{% endif %}">
          <b>{{ p.name }}</b><span class="lp">LP {{ p.lp }}</span>
        </span>
        {% endfor -%}
        {% if b.bots %}<span class="who"><b>AI</b><span class="lp">×{{ b.bots }}</span></span>{% endif %}
      </div>
    </div>
    {% endfor -%}
    {% if not blocks %}<div class="empty">现在没有进行中的对局。</div>{% endif %}
  </div>
</section>

{% if more -%}
<div class="more">…… 还有 {{ more }} 局</div>
{%- endif %}
{%- endblock -%}
