# 卫戍协议：盟约 · QQ 机器人插件配置示例
# 复制到你的 NoneBot 项目根目录的 .env 里按需修改（键名小写；大写也认）。

# ---- 游戏服（Stronghold Bot Bridge 接入，契约见 docs/BRIDGE-API.md）----------------
# 裸核心默认 3000；走反向代理 / 容器入口时按实际端口填。
stronghold_api_base=http://127.0.0.1:3000
stronghold_api_prefix=/api/bot/v1
# 服务端配的 BOT_TOKEN。留空只能读公开接口（/meta）。
stronghold_api_token=
stronghold_timeout=8
# 服务端用自签 HTTPS 时才需要关。
stronghold_verify_tls=true
# 是否让请求走 HTTP_PROXY / ALL_PROXY 等环境变量。默认关：
# 游戏服一般在本机或内网，被环境里的代理劫走会直接报 502。
stronghold_use_env_proxy=false

# ---- 展示 ---------------------------------------------------------------------------
# 命令回复与日报推送出图（在线 / 对局 / 战绩 / 日报 各一张卡片）；渲染不可用时自动回退文本
stronghold_reply_image=true
stronghold_online_limit=20
stronghold_match_limit=10
stronghold_profile_matches=5

# ---- 账号绑定 -----------------------------------------------------------------------
# 发码后等玩家回码的有效期（分钟）
stronghold_bind_ttl_min=10
# 绑定表目录；留空 = <当前目录>/data/nonebot_plugin_stronghold_protocol
stronghold_data_dir=

# ---- 日报 ---------------------------------------------------------------------------
stronghold_report_enabled=true
stronghold_report_time=11:00
stronghold_report_tz=Asia/Shanghai
# 默认自动推送的群号；群里的「日报 开启 / 日报 关闭」会覆盖它
stronghold_report_groups=[]
# 每个称号最多列几人，0 = 全部
stronghold_report_max_titles=5
# 插件管理员（能开关群推送）；NoneBot 的 SUPERUSERS 天然也是管理员
stronghold_admins=[]

# ---- 图片菜单（可选，需要 nonebot-plugin-picmenu-next，详见 docs/MENU.md）----------
# 菜单标题/页脚显示的名字
stronghold_menu_server_name=卫戍协议：盟约
# 菜单里显示服务器实时状态（在线人数 / 今日战报）；关掉就完全不请求游戏服
stronghold_menu_live=true
# 实时状态缓存秒数
stronghold_menu_live_ttl=30
# 菜单取实时数据的超时（秒）
stronghold_menu_timeout=2

# —— 下面是 picmenu-next 自己的配置（它和它的依赖 cookit 要求的）——
# 1) 本插件已在 metadata 里声明详情页用 stronghold，通常不用再配；要全局换再写：
# PMN_DETAIL_TEMPLATE=stronghold
# PMN_FUNC_DETAIL_TEMPLATE=stronghold
# 2) cookit 拒绝 localstore 用系统默认目录，必须显式指定
# LOCALSTORE_USE_CWD=True
# 3) 出图需要浏览器后端
# RENDER_BACKEND=playwright
# RENDER_STARTUP_MODE=probe
# 4) 模板浅色变体（默认就是设计语言本身的近黑墨绿）
# PMN_STRONGHOLD_LIGHT=true
